<h1>Forgot Password</h1>

<form action="/reqOTP" method="POST">
    <div>
        <label>Email:</label>
        <input
            type="email"
            name="email"
            value="<%= email || '' %>"
            required
        >
    </div>

<% if (error) { %>
        <p style="color:red;"><%= error %></p>
<% } %>

    <button type="submit">Request OTP</button>
</form>

<% if (showOTP) { %>

<form action="/verifyOTP" method="POST">

    <input
        type="hidden"
        name="email"
        value="<%= email %>"
    >

    <div>
        <label>OTP:</label>
        <input
            type="text"
            name="otp"
            required
        >
        <label>TIMER:</label>
        <span id="timer">5:00
        </span>

    </div>

    <button type="submit">
        Verify OTP
    </button>

</form>

<% } %>
<script>
let otpTime = 300;

let timer = setInterval(() => {
    const gm = Math.floor(otpTime / 60);
    const gs = String(otpTime % 60).padStart(2, "0");

    document.getElementById("timer").textContent = `${gm}:${gs}`;

    if (otpTime === 0) {
        clearInterval(timer);
    } else {
        otpTime--;
    }
}, 1000);

</script>
